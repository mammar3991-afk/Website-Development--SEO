# Copy to .env and fill in. .env is git-ignored and must never be shared or committed.
SERVER_HOST=
SERVER_USER=root
SERVER_PORT=22
# Use an SSH key if you can (path below). If you only have a password, fill SERVER_PASSWORD
# and leave SSH_KEY empty; the script then uses sshpass.
SSH_KEY=
SERVER_PASSWORD=
# Folder on the server that nginx serves. Releases go in releases/, 'current' is a symlink.
REMOTE_BASE=/var/www/octavebytes-preview
# Optional: preview hostname you will point at the server (informational)
PREVIEW_HOSTNAME=
